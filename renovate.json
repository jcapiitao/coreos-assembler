{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>platform-engineering-org/.github"
  ],
  "dependencyDashboard": "false",
  "packageRules": [
    {
      "matchDatasources": ["repology"],
      "versioning": "rpm"
    },
    {
      "description": "Disable updates for Golang dependencies",
      "matchManagers": ["gomod"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": ["regex"],
      "fileMatch": ["^rpms.lock.yaml$"],
      "matchStrings": [
	"\"name\":\\s*\"(?<packageName>[^\"]+)\",\\s*\"evr\":\\s*\"(?<currentValue>[^\"]+)\",\\s*\"repoid\":\\s*\"(?<repo>[^\"]+)\""
      ],
      "depNameTemplate": "{{{repo}}}/{{{packageName}}}",
      "datasourceTemplate": "repology",
      "versioningTemplate": "rpm"
    }
  ]
}
