{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": ["main"],
  "branchPrefix": "renovate/",
  "automergeType": "pr",
  "prHourlyLimit": 0,
  "ignorePaths": [
    "vendor/**"
  ],
  "branchConcurrentLimit": 0,
  "logLevelRemap": [
    {
      "matchMessage": "/^Custom manager fetcher/",
      "newLogLevel": "info"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["go"],
      "enabled": false,
      "description": "Disable updates for Go modules"
    },
    {
      "matchDatasources": ["golang-version"],
      "enabled": false,
      "description": "Disable updates for Go modules"
    },
    {
      "matchDatasources": ["custom.oc"],
      "extractVersion": "openshift-client-linux-(?<version>.+)\\.tar\\.gz"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "custom.oc",
      "fileMatch": ["artifacts.lock.yaml"],
      "versioningTemplate": "semver",
      "matchStrings": [
        "#\\s*renovate:\\s*(datasource=(?<datasource>.*?)\\s*)?depName=(?<depName>.*?)(\\s*versioning=(?<versioning>.*))?\\s*- download_url:.*openshift-client-linux-(?<currentValue>.*)\.tar\.gz"
      ]
    }
  ],
  "customDatasources": {
    "oc": {
      "defaultRegistryUrlTemplate": "https://mirror.openshift.com/pub/openshift-v4/x86_64/clients/ocp/latest/sha256sum.txt",
      "format": "plain"
    }
  }
}
